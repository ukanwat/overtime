# The look every demo shares (each tape Sources this). About 124 columns by 31 rows.
Set Shell bash
Set Theme "TokyoNight"
Set FontFamily "Menlo"
Set FontSize 16
Set LineHeight 1.2
Set Width 1280
Set Height 760
Set Padding 28
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 35ms
Set Framerate 24
Set PlaybackSpeed 1
Set CursorBlink false
# Real model turns vary; waits on screen text give up only after this long.
Set WaitTimeout 5m
